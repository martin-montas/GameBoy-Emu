#!/usr/bin/env bash

set -euo pipefail

# ----------------------------------------
# Simple RGBDS Game Boy build script
# Usage:
#   ./build.sh source.asm
# ----------------------------------------

if [ $# -ne 1 ]; then
    echo "Usage: $0 file.asm"
    exit 1
fi

SOURCE="$1"

if [ ! -f "$SOURCE" ]; then
    echo "Error: file '$SOURCE' does not exist"
    exit 1
fi

# Strip extension
NAME="$(basename "$SOURCE" .asm)"

OBJ="${NAME}.o"
ROM="${NAME}.gb"
SYM="${NAME}.sym"
MAP="${NAME}.map"

echo "[1/3] Assembling..."
rgbasm -Wall -Werror -o "$OBJ" "$SOURCE"

echo "[2/3] Linking..."
rgblink \
    -o "$ROM" \
    -n "$SYM" \
    -m "$MAP" \
    "$OBJ"

echo "[3/3] Fixing header..."
rgbfix \
    -v \
    -p 0 \
    "$ROM"

echo
echo "Build complete:"
echo "  ROM : $ROM"
echo "  SYM : $SYM"
echo "  MAP : $MAP"
